# Configuration de l'assistant BizAssist AI

# Clé API Google Gemini (Obtenez-la gratuitement sur https://aistudio.google.com/)
GEMINI_API_KEY=

# Modèle Gemini à utiliser (ex: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# Port d'écoute du serveur backend (par défaut : 3001)
PORT=3001
